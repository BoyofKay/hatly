# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgres://hatly:hatly@localhost:5432/hatly_dev
# TLS to PostgreSQL. REQUIRED (true) in production/staging unless ALLOW_INSECURE_DB=true acknowledges a private network without TLS.
# DB_SSL_CA: optional PEM text of a provider CA (literal \n allowed). DB_SSL_REJECT_UNAUTHORIZED=false is rejected in production.
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Local development ONLY. When true, generated OTP codes are written to
# the server log instead of sent by SMS, so you can log in without a
# real SMS provider configured. This MUST be unset/false in every
# deployed environment (staging, production) — it exists purely so
# Phase 1/2 development doesn't block on an SMS provider decision.
OTP_LOG_CODE_FOR_LOCAL_DEV=true

# Media storage (M5 Batch 2)
# STORAGE_DRIVER=local (default) keeps media on the local filesystem (UPLOADS_LOCAL_DIR below) — this is all hatly_dev needs;
# none of the other STORAGE_* values are read. STORAGE_DRIVER=s3 stores media in ANY S3-compatible object store (no provider is
# chosen here). The credentials are server-side only; clients never receive them.
STORAGE_DRIVER=local
# Leave empty for the AWS default (https://s3.<region>.amazonaws.com); set for another S3-compatible service (https in production).
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# true = bucket in the URL path (needed by many S3-compatible services); default is automatic (path-style for IP/localhost endpoints).
STORAGE_FORCE_PATH_STYLE=
# private (default): the bucket is not public; /uploads/files/<name> 302-redirects to a short-lived signed GET URL.
# public: stored references are absolute URLs under STORAGE_PUBLIC_BASE_URL (https://, required for public).
STORAGE_ACCESS=private
STORAGE_PUBLIC_BASE_URL=
# Lifetime of signed read URLs for private storage (1-3600 seconds, default 300).
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Optional key prefix inside the bucket, e.g. "hatly/media".
STORAGE_KEY_PREFIX=

# Push (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Maps
# MAPS_PROVIDER=google (default, and the ONLY value ever allowed when NODE_ENV=production —
# enforced at boot, not just by convention) requires a real GOOGLE_MAPS_API_KEY below.
# MAPS_PROVIDER=deterministic is a dev/test-only straight-line (non-driving) distance
# approximation with no external calls and no credentials — lets the delivery/checkout flow
# be exercised locally without a real Maps key. Never valid in production; the app refuses to
# boot with this value if NODE_ENV=production.
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# Business defaults (overridable via admin config later)
DEFAULT_CITY=Belbeis
DEFAULT_CURRENCY=EGP

# First SUPER_ADMIN bootstrap (npm run bootstrap:admin) — read once by
# that script only, never by the running application. Not required at
# normal app startup; set these only when actually running the
# bootstrap command, then unset/rotate them.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Local filesystem upload storage (Chunk 12B-1 correction) — used by
# LocalFilesystemUploadProvider, the default UPLOAD_PROVIDER binding.
# Defaults to ./uploads-storage relative to the process working
# directory if unset. Use STORAGE_DRIVER=s3 (STORAGE_* vars above) for a
# multi-instance production deployment — local disk storage does not
# survive a redeploy or work across multiple backend instances.
UPLOADS_LOCAL_DIR=
UPLOADS_PUBLIC_URL_PREFIX=/uploads/files

# Unifonic SMS provider (production Customer OTP delivery). Both
# required for real SMS to actually send — if either is missing,
# OTP requests fail closed with a controlled SMS_PROVIDER_UNAVAILABLE
# error rather than silently succeeding without sending anything.
# SenderID must be registered/approved with Unifonic for Egyptian
# traffic before production use — this app does not automate that.
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=


# ---------------------------------------------------------------------------
# M5 Batch 1 — runtime security & configuration hardening
# The app validates its configuration at boot (src/config/env.validation.ts). Development (NODE_ENV=development, the
# `hatly_dev` workflow) needs only DATABASE_URL + the two JWT secrets as before. NODE_ENV=production or staging ALSO requires:
#   - JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: >= 32 random characters each, different from each other, not placeholders
#   - DATABASE_URL: a non-localhost, non-*_dev/_test database with credentials; DB_SSL=true (or ALLOW_INSECURE_DB=true)
#   - REDIS_URL: explicit and non-localhost (rediss:// for TLS)
#   - CORS_ALLOWED_ORIGINS, UPLOADS_LOCAL_DIR (absolute path; only when STORAGE_DRIVER=local), MAPS_PROVIDER=google + GOOGLE_MAPS_API_KEY
#   - UNIFONIC_APP_SID + UNIFONIC_SENDER_ID (or ALLOW_MISSING_SMS_PROVIDER=true), FCM_* trio (or ALLOW_MISSING_PUSH_PROVIDER=true)
#   - OTP_LOG_CODE_FOR_LOCAL_DEV must NOT be true
# Optional:
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://ops.example.com   # exact web origins; never "*". Empty in dev = open (local workflow).
# TRUST_PROXY=1                 # number of reverse proxies in front of the API (or a comma list of proxy IPs/CIDRs). Unset = forwarded
#                               # headers ignored. "true"/"*" is rejected. Needed behind a load balancer so rate limiting sees real client IPs.
# ENABLE_API_DOCS=true          # Swagger UI. On by default outside production/staging; opt-in inside them.
# DB_SSL_CA=                    # PEM of the database provider's CA, when DB_SSL=true needs it
# ALLOW_INSECURE_DB=true        # acknowledge a private-network database without TLS (production/staging only)
# ALLOW_MISSING_SMS_PROVIDER=true / ALLOW_MISSING_PUSH_PROVIDER=true   # acknowledge a deployment without SMS / push

# Database connection pool (M5 Batch 3). Defaults: 10 connections, 10 s wait for a free one (instead of waiting forever).
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000

# Rate limiting and upload protection (M5 Batch 4) — defaults shown; see docs/security/rate-limiting-and-media.md
# Requests per minute, per client (the logged-in user, else the IP): per ROUTE (default for any route without its own limit) and
# across ALL routes combined. Counters live in the shared Redis, so the limits hold across several backend instances.
# RATE_LIMIT_ROUTE_PER_MINUTE=100
# RATE_LIMIT_CLIENT_PER_MINUTE=600
# Image uploads processed at once (each in-flight 5 MB upload costs ~20-45 MB of memory); extra uploads wait in a queue.
# UPLOAD_MAX_CONCURRENT=6

# Dev/tester only: when set, `npm run seed:dev-marketplace` creates/resets the six tester accounts (customer, vendor,
# vendor manager, two drivers, admin — fixed phones in src/scripts/seed-dev-marketplace.ts) with this password.
# Never set in production.
# TESTER_PASSWORD=
