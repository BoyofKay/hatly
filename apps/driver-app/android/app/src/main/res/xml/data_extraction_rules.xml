<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup / device-transfer rules. The driver app keeps nothing worth restoring on another device: the account lives on
     the server, and the only local secrets are the sign-in tokens (flutter_secure_storage), whose Keystore key never leaves the device — a
     restored copy of the encrypted file could not be read there, and it must not travel in a cloud backup in the first place.
     Together with android:allowBackup="false" in AndroidManifest.xml. Verified in the merged release manifest by scripts/launch/build-android-release.sh. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
