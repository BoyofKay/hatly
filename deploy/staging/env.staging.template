# Hatly SALES STAGING environment — TEMPLATE. Never commit the generated file.
# Generate the real one with:  ./init-staging-env.sh   (writes /opt/hatly-staging/.env.staging, mode 600, secrets never printed)
# Names below are consumed by docker-compose.staging.yml (STAGING_*) and by the backend (everything else).

# ---- isolation: staging-only database + redis (their own volumes; no published ports) ----
STAGING_DB_NAME=hatly_staging
STAGING_DB_USER=hatly_staging
STAGING_DB_PASSWORD=@@GENERATE@@
STAGING_REDIS_PASSWORD=@@GENERATE@@
DATABASE_URL=postgres://hatly_staging:@@DB_PASSWORD@@@postgres:5432/hatly_staging
REDIS_URL=redis://:@@REDIS_PASSWORD@@@redis:6379
# PostgreSQL is reachable only on the private compose network and does not offer TLS there; this acknowledges it explicitly.
DB_SSL=false
ALLOW_INSECURE_DB=true

# ---- public URLs (HTTPS through the reverse proxy) ----
STAGING_PUBLIC_API_URL=https://@@API_HOST@@/api/v1
CORS_ALLOWED_ORIGINS=https://@@DASHBOARD_HOST@@
STAGING_API_HOST_PORT=13000
STAGING_DASHBOARD_HOST_PORT=13001

# ---- app ----
NODE_ENV=@@NODE_ENV@@
PORT=3000
API_PREFIX=api/v1
# one reverse proxy (Caddy) in front of the API. If the API hostname is proxied through Cloudflare (orange cloud) the chain is
# longer — see RUNBOOK.md "TLS / Cloudflare" before changing this.
TRUST_PROXY=1
ENABLE_API_DOCS=false
OTP_LOG_CODE_FOR_LOCAL_DEV=false

# ---- auth secrets (generated, >= 32 chars, different) ----
JWT_ACCESS_SECRET=@@GENERATE@@
JWT_REFRESH_SECRET=@@GENERATE@@
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- admin two-factor (docs/security/mfa-rollout.md) ----
# Dedicated TOTP-secret encryption key, generated BEFORE any admin enrols, so a later JWT_REFRESH_SECRET rotation cannot orphan
# enrolled authenticators. Never change it once admins are enrolled. The enrolment POLICY stays off until the rollout step that
# turns it on (after every SUPER_ADMIN has enrolled).
MFA_ENCRYPTION_KEY=@@MFA_KEY@@
DASHBOARD_ADMIN_MFA_REQUIRED=false

# ---- media: local volume (NOT any production bucket) ----
STORAGE_DRIVER=local
UPLOADS_LOCAL_DIR=/data/uploads
UPLOADS_PUBLIC_URL_PREFIX=/uploads/files

# ---- external providers ----
# Staging mode is STRICT: it refuses to boot without a Google Maps key (distance/delivery fee) unless you use the documented
# fallback (RUNBOOK.md "Maps decision"). SMS and push are acknowledged-absent: Customer OTP stays OFF for Sales.
MAPS_PROVIDER=@@MAPS_PROVIDER@@
GOOGLE_MAPS_API_KEY=@@MAPS_KEY@@
ALLOW_MISSING_SMS_PROVIDER=true
ALLOW_MISSING_PUSH_PROVIDER=true

# lets the (idempotent, additive) catalog seed run against THIS isolated database only; never accepted for a name containing "prod"
SEED_ALLOW_DATABASE=hatly_staging
DEFAULT_CITY=Belbeis
DEFAULT_CURRENCY=EGP
