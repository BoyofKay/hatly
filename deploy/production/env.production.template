# Hatly PRODUCTION environment — TEMPLATE rendered by deploy/production/init-production-env.sh ON THE HOST.
# No value in this file is a real secret and none may ever be: every double-at marker is replaced by a value generated on the host (openssl) or
# read from the operator's input on stdin. The rendered file (/opt/hatly-prod/.env.production, mode 600) is never printed, committed,
# pasted into a ticket or copied into an image. It is used twice: as the compose --env-file (interpolation of the postgres/redis service
# passwords) and as the backend's env_file — one file, so the two can never disagree.
# Boot rules: apps/backend/src/config/env.validation.ts (a wrong value stops the backend with a secret-free message). The rendered file is
# checked against those exact rules by scripts/launch/test/production-env.test.mjs (local) before it is ever used.

# --- compose interpolation (postgres / redis services) ---
PROD_DB_NAME=hatly_prod
PROD_DB_USER=hatly
PROD_DB_PASSWORD=@@DB_PASSWORD@@
PROD_REDIS_PASSWORD=@@REDIS_PASSWORD@@
# baked into the dashboard bundle at build time (and its CSP connect-src)
PROD_PUBLIC_API_URL=https://api.hatly.dev/api/v1

# --- runtime ---
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
# The backend sees exactly ONE trusted hop: the shared Caddy. Caddy accepts the production hostnames only from Cloudflare's published
# address ranges and REPLACES X-Forwarded-For with Cloudflare's CF-Connecting-IP (the real client), so one hop yields the real client IP
# and nothing a client sends can spoof it (deploy/production/Caddyfile.production-block). A hop COUNT, never "true".
TRUST_PROXY=1
ENABLE_API_DOCS=false
OTP_LOG_CODE_FOR_LOCAL_DEV=false

# --- browser access (exact origins served by the dashboard) ---
CORS_ALLOWED_ORIGINS=https://hatly.dev,https://www.hatly.dev,https://admin.hatly.dev

# --- data stores (compose service names on the private hatly-prod_internal network) ---
DATABASE_URL=postgres://hatly:@@DB_PASSWORD@@@postgres:5432/hatly_prod
# Private compose network without TLS to Postgres: explicit acknowledgement (a managed database would use DB_SSL=true + DB_SSL_CA).
DB_SSL=false
ALLOW_INSECURE_DB=true
DB_POOL_MAX=10
REDIS_URL=redis://:@@REDIS_PASSWORD@@@redis:6379

# --- secrets (generated on the host; each different) ---
JWT_ACCESS_SECRET=@@JWT_ACCESS@@
JWT_REFRESH_SECRET=@@JWT_REFRESH@@
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# 32 random bytes, base64. Generated once, BEFORE the first admin enrols; NEVER change it (docs/security/mfa-rollout.md). Back it up.
MFA_ENCRYPTION_KEY=@@MFA_KEY@@
# Stays false until two SUPER_ADMINs are enrolled and verified; flipping it is a separate, explicit decision.
DASHBOARD_ADMIN_MFA_REQUIRED=false

# --- media: named volume hatly-prod_uploads mounted at /data/uploads (survives redeploys; included in the backups) ---
STORAGE_DRIVER=local
UPLOADS_LOCAL_DIR=/data/uploads
UPLOADS_PUBLIC_URL_PREFIX=/uploads/files

# --- maps: written by init-production-env.sh — `google` + GOOGLE_MAPS_API_KEY when the operator supplies a key, otherwise `none`
#     (PD-009 G: Maps deferred — delivery priced and bounded by the selected Delivery Zone, dispatch ranks by straight-line distance,
#     address search off). Switching to Google later = add the key and set MAPS_PROVIDER=google; nothing else changes.
#     The development stub `deterministic` is refused in production.

# --- business defaults ---
DEFAULT_CITY=Belbeis
DEFAULT_CURRENCY=EGP

# --- operator input (appended by init-production-env.sh): MAPS_PROVIDER (+ GOOGLE_MAPS_API_KEY when given); UNIFONIC_APP_SID + UNIFONIC_SENDER_ID or
#     ALLOW_MISSING_SMS_PROVIDER=true; FCM_PROJECT_ID + FCM_CLIENT_EMAIL + FCM_PRIVATE_KEY or ALLOW_MISSING_PUSH_PROVIDER=true.
# --- never in this file: BOOTSTRAP_ADMIN_* (passed once to bootstrap:admin), TESTER_PASSWORD, SEED_* (never in production).
