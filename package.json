{
  "name": "hatly",
  "private": true,
  "version": "0.1.0",
  "description": "Hatly delivery marketplace monorepo (backend, dashboard, shared packages). Flutter apps live under apps/ but are managed via the Flutter/Dart toolchain, not npm.",
  "workspaces": [
    "apps/backend",
    "apps/dashboard",
    "packages/*"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=apps/backend",
    "backend:build": "npm run build --workspace=apps/backend",
    "dashboard:dev": "npm run dev --workspace=apps/dashboard",
    "dashboard:build": "npm run build --workspace=apps/dashboard"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "multer": "2.4.0",
    "qs": "6.16.0",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "next": {
      "postcss": "8.5.28"
    },
    "lodash": "4.18.1",
    "@nestjs/swagger": {
      "js-yaml": "4.3.2"
    },
    "google-gax": {
      "glob": "10.5.0"
    }
  }
}
